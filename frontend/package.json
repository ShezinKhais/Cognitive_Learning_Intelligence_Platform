{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:attention": "node scripts/prepare-attention.mjs",
    "predev": "npm run prepare:attention",
    "prebuild": "npm run prepare:attention",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "eval:attention": "node --experimental-strip-types scripts/evaluate-attention.ts ../backend/tests/eval/cv --out ../backend/tests/eval/cv/RESULTS.md",
    "build:e2e": "npm run prepare:attention && vite build --config vite.e2e.config.ts",
    "test:browser": "playwright test",
    "check:browser": "tsc --ignoreConfig --noEmit --module esnext --moduleResolution bundler --target es2022 --lib es2022,dom --skipLibCheck e2e/student.spec.ts playwright.config.ts vite.e2e.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "@microsoft/teams-js": "^2.40.0",
    "@ricky0123/vad-web": "0.0.31",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "onnxruntime-web": "1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
