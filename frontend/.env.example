# Enable only after the AI 1 upload handler and General CS user progress
# channel are deployed together with this frontend.
VITE_MATERIAL_PIPELINE_ENABLED=false

# Enable after BBIS deploys GET /api/v1/sessions and General CS enables
# authorised session WebSockets with replay on /ws/session.
VITE_LIVE_SESSIONS_ENABLED=false

# The Teams meeting page is available at /teams/meeting. Outside Teams, use a
# URL such as /teams/meeting?teamsMock=1&meetingId=MEETING_ID&theme=dark.
VITE_TEAMS_MOCK_ENABLED=true
