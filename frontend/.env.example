# Lecture upload with live processing progress. The upload route and the
# lecturer's progress channel are both on main.
VITE_MATERIAL_PIPELINE_ENABLED=true

# The student's session list (GET /api/v1/sessions) and the live session over
# /ws/session, with replay after a dropped connection.
VITE_LIVE_SESSIONS_ENABLED=true

# Optional Phase 6: deploy self-hosted attention assets before enabling
# (npm run prepare:attention).
VITE_LOCAL_ATTENTION_ENABLED=false

# The Socratic tutor (POST /api/v1/sessions/{session_id}/chat), streamed and
# cancellable. Applies to web and Teams.
VITE_SOCRATIC_CHAT_ENABLED=true

# Microsoft Teams simulation is for local development/demo only.
# To test locally, use a URL such as:
# /teams/meeting?teamsMock=1&meetingId=MEETING_ID&theme=dark
#
# Keep this disabled by default. The Teams integration also rejects simulated
# Teams context in production builds.
VITE_TEAMS_MOCK_ENABLED=false

# Vite server setting, not exposed to browser code. REST and WebSocket traffic
# both reach this backend. Change this if uvicorn uses a different port.
CLIP_BACKEND_URL=http://localhost:8000
