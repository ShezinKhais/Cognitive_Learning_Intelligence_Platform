# Copy to .env and fill in. Never commit .env.

# --- Application ---

CLIP_ENV=development
CLIP_SECRET_KEY=change-me-in-production-use-32-plus-bytes
CLIP_LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=60
# The client refreshes its token before it expires; the sign-in ends after this.
MAX_SIGN_IN_HOURS=12

# --- Database ---

DATABASE_URL=postgresql+asyncpg://clip:clip_dev_password@localhost:5432/clip

# --- LLM (Ollama, OpenAI-compatible endpoint) ---

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
# Tried once when OLLAMA_MODEL cannot answer. Leave empty for none.
OLLAMA_FALLBACK_MODEL=

# --- Model calls (the AI gateway) ---
# Every model call waits its turn here, so AI work cannot crowd out a live
# session. The defaults suit a laptop; see docs/ai-gateway.md.

# Calls sent to the model at once. Match Ollama's OLLAMA_NUM_PARALLEL: more
# than the server runs side by side only queues inside it, out of order.
AI_MAX_CONCURRENCY=2
# Calls allowed to wait, and how long one may wait, before being refused.
AI_QUEUE_LIMIT=32
AI_QUEUE_TIMEOUT_SECONDS=20
# Load the model at startup so the first student does not wait for it, and
# ask it for one word whenever it has been idle this long, so Ollama does
# not unload it. Keep this below OLLAMA_KEEP_ALIVE (5 minutes by default).
AI_WARMUP_ENABLED=true
AI_KEEP_WARM_SECONDS=240

# --- The tutor ---
# Questions one student may ask the tutor in a minute, and how many excerpts
# of the lecture material are put to the model with each. See docs/tutor-chat.md.
CHAT_QUESTIONS_PER_MINUTE=6
CHAT_RETRIEVED_CHUNKS=5

# Short-answer questions with each upload. Leave off until the question table
# stores reference answers (Phase 5).
FREE_TEXT_QUESTIONS_ENABLED=false
# Ask the model a second time whether each multiple choice question has exactly
# one right option on its cited slide, and drop it if not.
QUESTION_VERIFICATION_ENABLED=true

# Describe the images in uploaded material with a vision model, so diagrams can
# be searched. Needs the model pulled first: `ollama pull qwen2.5vl:3b`.
IMAGE_CAPTIONING_ENABLED=false
IMAGE_CAPTION_MODEL=qwen2.5vl:3b
# LibreOffice turns WMF/EMF charts into images the model can read. Leave empty
# to find it automatically.
LIBREOFFICE_PATH=

# Read scanned PDF pages with OCR. Needs Tesseract installed: `brew install
# tesseract` on a Mac. Without it, scanned pages are skipped with a warning.
# Leave the path empty to find it automatically.
OCR_ENABLED=true
TESSERACT_PATH=
OCR_LANGUAGE=eng

# --- Teams (populated by `teams app create --env .env`) ---

CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# --- Session behaviour ---

# Once a question closes, the next is due after a fresh random wait between
# these two, so the class cannot predict it. Both 0 turns the automatic cycle
# off (manual delivery only).
CHECKPOINT_INTERVAL_MIN_SECONDS=900
CHECKPOINT_INTERVAL_MAX_SECONDS=1200
CHECKPOINT_RESPONSE_WINDOW_SECONDS=30
COMPREHENSION_ALERT_THRESHOLD=0.50
COMPREHENSION_ALERT_MIN_RESPONDENTS=5
DYNAMIC_PROMPT_MAX_PER_STUDENT=3
# How long a private attention prompt stays up, and how many questions in a
# row a student may let pass before being sent one (0 turns that off).
ATTENTION_PROMPT_TTL_SECONDS=60
ATTENTION_PROMPT_AFTER_MISSED_QUESTIONS=2

# --- Attention signals ---
# See docs/signals-and-rooms.md.

# The least time between two signal.attention events on one socket, after a
# burst of five. The client sends one every five seconds. 0 turns the limit off.
ATTENTION_SIGNAL_MIN_INTERVAL_SECONDS=2.0
# How often a running session rescores its signals and checks its breakout rooms.
SIGNAL_WATCH_SECONDS=10.0
# Signal time needed in the last two minutes before signals alone may prompt a
# student, so nobody is judged on the first seconds after turning a camera on.
# 0 turns prompting from signals off.
REFOCUS_MIN_SIGNAL_SECONDS=45.0
# The least time between two prompts sent to one student on their signals alone.
REFOCUS_COOLDOWN_SECONDS=300.0

# --- Breakout rooms ---
# How long one voice reading describes a member of a room.
ROOM_VOICE_FRESH_SECONDS=20.0
# Silence before a room is quiet, and before the lecturer is alerted that it
# needs attention (the second must be greater than the first).
ROOM_QUIET_AFTER_SECONDS=60.0
ROOM_NEEDS_ATTENTION_AFTER_SECONDS=180.0
# Rooms one session may have. A new room beyond this is refused.
MAX_ROOMS_PER_SESSION=50

# --- Uploads ---

MAX_UPLOAD_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=pdf,pptx,docx,txt

# --- Retention (UAE PDPL) ---

DATA_RETENTION_DAYS=90
# How often the purge of data past that period runs, and how long one run may
# take. A run cut short carries on at the next. See docs/reports.md.
RETENTION_PURGE_INTERVAL_HOURS=24.0
RETENTION_PURGE_TIMEOUT_MINUTES=30.0

# --- Teams checkpoint notifications (public cloud, single-tenant Azure Bot) ---
# Requires bot credentials above, approved meeting RSC permissions, a configured
# C.L.I.P meeting tab, and enrolled students' verified Teams identity mappings.
TEAMS_NOTIFICATIONS_ENABLED=false
TEAMS_APP_BASE_URL=
# Manifest's top-level id (TEAMS_APP_ID), which may differ from CLIENT_ID/BOT_ID.
TEAMS_APP_ID=
