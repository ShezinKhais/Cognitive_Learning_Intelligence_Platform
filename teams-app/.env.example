# Copy to teams-app/.env (ignored by git) and fill in once IT allows
# custom app uploads. scripts/package_teams_app.py reads it.

# The Teams app's id, from the app registration.
TEAMS_APP_ID=

# The bot's Entra app id. The backend's CLIENT_ID is the same id.
BOT_ID=

# Where Teams loads the tabs and posts to the bot: the dev tunnel's HTTPS
# address in development. BASE_DOMAIN is taken from it.
BASE_URL=
