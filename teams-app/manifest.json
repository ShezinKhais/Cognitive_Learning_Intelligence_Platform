{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "0.3.4",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "CSIT321 Team 4, UOWD",
    "websiteUrl": "https://github.com/ShezinKhais/Cognitive_Learning_Intelligence_Platform",
    "privacyUrl": "${{BASE_URL}}/privacy",
    "termsOfUseUrl": "${{BASE_URL}}/terms"
  },
  "name": {
    "short": "CLIP",
    "full": "Cognitive Learning Intelligence Platform"
  },
  "description": {
    "short": "AI engagement assistant for live online classes.",
    "full": "C.L.I.P provides engagement indicators, lecturer-reviewed AI comprehension checkpoints and a Socratic learning assistant. Optional student camera and microphone indicators are processed locally, with only derived signals transmitted. Optional lecturer microphone transcription temporarily processes audio on the C.L.I.P server; nearby voices may be picked up. Recognized text is stored and automatically shared with enrolled course students and the catch-up assistant as an unreviewed transcript. Optional Teams transcript imports create private draft teaching minutes for lecturer review before publication."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#6264A7",

  "showLoadingIndicator": true,

  "staticTabs": [
    {
      "entityId": "clip.home",
      "name": "C.L.I.P",
      "contentUrl": "${{BASE_URL}}/open",
      "websiteUrl": "${{BASE_URL}}/login",
      "scopes": ["personal"]
    }
  ],

  "configurableTabs": [
    {
      "configurationUrl": "${{BASE_URL}}/config",
      "scopes": ["groupChat"],
      "context": ["meetingChatTab", "meetingDetailsTab", "meetingSidePanel"],
      "supportedSharePointHosts": []
    }
  ],

  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": ["groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],

  "permissions": ["identity"],

  "devicePermissions": ["media"],

  "webApplicationInfo": {
    "id": "${{BOT_ID}}",
    "resource": "api://${{BASE_DOMAIN}}/${{BOT_ID}}"
  },

  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "OnlineMeeting.ReadBasic.Chat",
          "type": "Application"
        },
        {
          "name": "OnlineMeetingParticipant.Read.Chat",
          "type": "Application"
        },
        {
          "name": "OnlineMeetingNotification.Send.Chat",
          "type": "Application"
        }
      ]
    }
  },

  "validDomains": ["${{BASE_DOMAIN}}"]
}
