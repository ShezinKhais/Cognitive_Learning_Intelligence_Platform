{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "0.2.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "CSIT321 Team 4, UOWD",
    "websiteUrl": "https://github.com/ShezinKhais/Cognitive_Learning_Intelligence_Platform",
    "privacyUrl": "${{BASE_URL}}/privacy",
    "termsOfUseUrl": "${{BASE_URL}}/terms"
  },
  "name": {
    "short": "CLIP",
    "full": "Cognitive Learning Intelligence Platform"
  },
  "description": {
    "short": "AI engagement assistant for live online classes.",
    "full": "C.L.I.P provides real-time engagement indicators, AI-generated comprehension checkpoints grounded in lecturer-approved material, and a Socratic learning assistant. Privacy-first: no raw video, audio, transcripts or biometric data is ever stored. Human-in-the-loop: the lecturer retains all teaching decisions."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#6264A7",

  "showLoadingIndicator": true,

  "staticTabs": [
    {
      "entityId": "clip.student",
      "name": "My Learning",
      "contentUrl": "${{BASE_URL}}/student",
      "websiteUrl": "${{BASE_URL}}/student",
      "scopes": ["personal"]
    },
    {
      "entityId": "clip.lecturer",
      "name": "Lecturer",
      "contentUrl": "${{BASE_URL}}/open/lecturer",
      "websiteUrl": "${{BASE_URL}}/lecturer/sessions",
      "scopes": ["personal"]
    },
    {
      "entityId": "clip.admin",
      "name": "Administration",
      "contentUrl": "${{BASE_URL}}/open/admin",
      "websiteUrl": "${{BASE_URL}}/admin",
      "scopes": ["personal"]
    }
  ],

  "configurableTabs": [
    {
      "configurationUrl": "${{BASE_URL}}/config",
      "scopes": ["groupChat"],
      "context": ["meetingSidePanel"],
      "supportedSharePointHosts": []
    }
  ],

  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": ["groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],

  "permissions": ["identity"],

  "devicePermissions": ["media"],

  "webApplicationInfo": {
    "id": "${{BOT_ID}}",
    "resource": "api://${{BASE_DOMAIN}}/${{BOT_ID}}"
  },

  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "OnlineMeeting.ReadBasic.Chat",
          "type": "Application"
        },
        {
          "name": "OnlineMeetingParticipant.Read.Chat",
          "type": "Application"
        },
        {
          "name": "OnlineMeetingNotification.Send.Chat",
          "type": "Application"
        }
      ]
    }
  },

  "validDomains": ["${{BASE_DOMAIN}}"]
}
