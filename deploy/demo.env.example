# Copy to deploy/demo.env (git-ignored by the *.env rule) and replace the
# placeholders. Never commit the copy.
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Use the output for CLIP_SECRET_KEY and, separately, for DEMO_DB_PASSWORD.
# Keep both URL-safe (hex is) because the password is placed in DATABASE_URL.

# Port the demo is published on (the only one).
DEMO_PORT=8088

# development: the built-in demo accounts exist and the app boots with default
# settings. production: see "Production checklist" in docs/deployment.md.
CLIP_ENV=development
CLIP_SECRET_KEY=replace-with-64-hex-characters
DEMO_DB_PASSWORD=replace-with-24-or-more-hex-characters

# Model server. host.docker.internal is the machine running Docker, so an
# Ollama started there is found without further setup. Nothing breaks if there
# is none: live sessions work from pre-generated questions.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5
EMBEDDING_MODEL=nomic-embed-text
AI_WARMUP_ENABLED=false

CLIP_LOG_LEVEL=INFO

# Frontend feature switches, read when the web image is built.
# Rebuild with --build after changing them.
VITE_MATERIAL_PIPELINE_ENABLED=true
VITE_LIVE_SESSIONS_ENABLED=true
VITE_SOCRATIC_CHAT_ENABLED=true
