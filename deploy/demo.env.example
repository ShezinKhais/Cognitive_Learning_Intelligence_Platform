# Copy to deploy/demo.env (git-ignored by the *.env rule) and replace the
# placeholders. Never commit the copy.
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Use the output for CLIP_SECRET_KEY and, separately, for DEMO_DB_PASSWORD.
# Keep both URL-safe (hex is) because the password is placed in DATABASE_URL.

# Port the demo is published on (the only one).
DEMO_PORT=8088

# development: the built-in demo accounts exist and the app boots with default
# settings. production: see "Production checklist" in docs/deployment.md.
CLIP_ENV=development
CLIP_SECRET_KEY=replace-with-64-hex-characters
DEMO_DB_PASSWORD=replace-with-24-or-more-hex-characters

# Model server. host.docker.internal is the machine running Docker, so an
# Ollama started there is found without further setup. Nothing breaks if there
# is none: live sessions work from pre-generated questions.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5
EMBEDDING_MODEL=nomic-embed-text
AI_WARMUP_ENABLED=false

# Build Tesseract into the backend image so scanned PDF pages are read (about 30 MB).
OCR_IN_IMAGE=false

CLIP_LOG_LEVEL=INFO

# Frontend feature switches, read when the web image is built.
# Rebuild with --build after changing them.
VITE_MATERIAL_PIPELINE_ENABLED=true
VITE_LIVE_SESSIONS_ENABLED=true
VITE_SOCRATIC_CHAT_ENABLED=true
VITE_LOCAL_ATTENTION_ENABLED=false

# Optional Teams registration. Backend-only secrets; never use VITE_ prefixes.
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
TEAMS_NOTIFICATIONS_ENABLED=false
TEAMS_APP_BASE_URL=
TEAMS_APP_ID=
# Leave empty: the bot signs in through its own tenant. botframework.com only for an
# older multi-tenant bot; with a current bot, Teams answers that token with 401.
TEAMS_BOT_TOKEN_TENANT=

# Optional lecturer microphone -> local speech recognition -> live chatbot.
# Separate from student attention sensors. See docs/live-transcription.md.
LIVE_TRANSCRIPTION_ENABLED=false
LIVE_TRANSCRIPTION_MODEL_PATH=/data/models/faster-whisper-base.en
LIVE_TRANSCRIPTION_LANGUAGE=en
LIVE_TRANSCRIPTION_CPU_THREADS=2

# Optional Graph transcript-ready notifications; requires transcript Graph admin consent.
TEAMS_TRANSCRIPTS_ENABLED=false
TEAMS_TRANSCRIPTS_AUTOMATIC_ENABLED=false
TEAMS_TRANSCRIPT_CALLBACK_URL=https://your-app.example/api/v1/teams/transcript-notifications
